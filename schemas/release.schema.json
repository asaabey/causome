            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "namespace",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "revisionId",
        "status",
        "label",
        "synonyms",
