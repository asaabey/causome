          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "under_review",
            "approved",
            "published"
          ]
        },
        "sourceId": {
          "type": "string",
