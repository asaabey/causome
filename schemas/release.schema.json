{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://causome.local/schemas/release.schema.json",
  "title": "Causome Milestone 1 root snapshot (scores unassessed)",
  "description": "Preview schema for a self-contained root graph. Successor releases and scored assessments are deferred. Scientific publication also requires trusted workflow validation.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "const": "0.1.0"
    },
    "diseaseId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "under_review",
        "approved",
        "published"
      ]
    },
    "illustrative": {
      "type": "boolean"
    },
    "parentReleaseId": {
      "type": "null"
    },
    "parentContentDigest": {
      "type": "null"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "evidenceCutoff": {
      "type": "string",
      "minLength": 1
    },
    "changeSetRevision": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "evidenceItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      },
      "minItems": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      },
      "minItems": 1
    },
    "scoringModels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scoringModel"
      },
      "minItems": 1
    },
    "mapViews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapView"
      },
      "minItems": 1
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layout"
      },
      "minItems": 1
    },
    "manifest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "schemaVersion": {
          "const": "0.1.0"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "schemaVersion",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "therapies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/therapy"
      }
    }
  },
  "required": [
    "id",
    "revisionId",
    "formatVersion",
    "diseaseId",
    "title",
    "status",
    "illustrative",
    "parentReleaseId",
