        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "enum": [
            "stimulates",
            "produces",
            "forms",
            "contributes_to",
            "is_associated_with"
          ]
        },
        "directionality": {
          "enum": [
            "directed",
            "symmetric"
          ]
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "not_applicable"
          ]
        },
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "assessmentId": {
          "type": "string",
          "minLength": 1
        },
        "supportingClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
