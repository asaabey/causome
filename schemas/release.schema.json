          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "revisionId",
        "status",
        "sourceId",
        "targetId",
        "predicate",
        "directionality",
        "polarity",
        "contextId",
        "assessmentId",
        "supportingClaimIds",
        "qualifyingClaimIds",
        "contradictingClaimIds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "is_associated_with"
              }
            }
          },
          "then": {
            "properties": {
              "directionality": {
                "const": "symmetric"
              },
              "polarity": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "properties": {
              "directionality": {
                "const": "directed"
              },
              "polarity": {
                "enum": [
                  "positive",
                  "negative"
                ]
              }
            }
          }
        }
      ]
