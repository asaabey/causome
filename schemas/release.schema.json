        "description": {
          "type": "string",
          "minLength": 1
        },
        "biologicalRoleClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "externalIds": {
          "type": "array",
