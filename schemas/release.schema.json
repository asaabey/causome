    "createdAt",
    "evidenceCutoff",
    "changeSetRevision",
    "entities",
    "relationships",
    "claims",
    "evidenceItems",
    "sources",
    "contexts",
    "assessments",
    "scoringModels",
    "mapViews",
    "layouts",
    "manifest",
    "therapies"
