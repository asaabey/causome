---
import AtlasLayout from '../../layouts/AtlasLayout.astro';
import MechanismMap from '../../components/MechanismMap';
import release from '../../data/release';

const entityLabel = (id: string) => release.entities.find(entity => entity.id === id)?.label ?? id;
const claimFor = (id: string) => release.claims.find(claim => claim.id === id);
const readable = (value: string) => value.replaceAll('_', ' ');
---
<AtlasLayout title="Systemic lupus erythematosus" description="A source-linked SLE mechanism candidate with claims, evidence systems and therapeutic interventions. Human domain review is pending.">
  <section class="disease-hero page-width">
    <div class="breadcrumbs"><a href="/">Atlas</a><span aria-hidden="true">/</span><span>Systemic lupus erythematosus</span></div>
    <div class="disease-heading">
      <div><p class="eyebrow">Disease map · SLE</p><h1>Systemic lupus<br />erythematosus</h1><p class="hero-description">Follow a proposed nucleic-acid, interferon and B-cell circuit, with a renal injury branch. Inspect the precise evidence and limits behind each connection.</p></div>
      <dl class="release-meta"><dt>Scientific candidate</dt><dd>{release.id}</dd><dt>Evidence cutoff</dt><dd>{release.evidenceCutoff} · Review pending</dd></dl>
    </div>
    <aside class="preview-notice" aria-label="Scientific review status"><span class="notice-symbol" aria-hidden="true">i</span><div><strong>Source checked · Human domain review pending</strong>This proposed synthesis combines human studies, cell cultures and animal models. Individual claims identify those differences. All scores are Not assessed; this candidate has no publication approval.</div></aside>
  </section>
  <section class="map-section" aria-labelledby="map-heading">
    <div class="map-section-heading"><div><h2 id="map-heading">Mechanism map</h2><p>{release.entities.length} entities · {release.relationships.length} relationships · {release.therapies.length} therapies</p></div><a href="#mechanism-outline">Read the text outline ↓</a></div>
    <MechanismMap release={release} client:load />
    <noscript><p class="preview-notice">The interactive map needs JavaScript. Every entity, relationship, therapy and evidence item is available in the text outline below.</p></noscript>
  </section>
  <section id="mechanism-outline" class="outline-section page-width" aria-labelledby="outline-heading">
    <p class="eyebrow">An alternative view</p><h2 id="outline-heading">The mechanism, in words</h2><p>The complete candidate remains available without JavaScript. Source checking records what the cited study supports; human domain review of the synthesis remains pending.</p>
    <details open><summary>Entities ({release.entities.length})</summary><div class="outline-content">{release.entities.map(entity => <article id={`entity-${entity.id}`}><span class="record-label">{readable(entity.entityClass)} · Candidate</span><h3>{entity.label}</h3><p>{entity.description}</p><p class="unassessed">Mechanistic weight, evidence confidence, and therapeutic leverage: Not assessed.</p><ul>{entity.biologicalRoleClaimIds.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul></article>)}</div></details>
    <details open><summary>Relationships ({release.relationships.length})</summary><div class="outline-content">{release.relationships.map(relationship => <article id={`relationship-${relationship.id}`}><span class="record-label">{relationship.directionality === 'symmetric' ? 'Symmetric association' : 'Directed relationship'} · Candidate</span><h3>{entityLabel(relationship.sourceId)} {readable(relationship.predicate)} {entityLabel(relationship.targetId)}</h3><p>Context: {release.contexts.find(context => context.id === relationship.contextId)?.label}. Polarity: {readable(relationship.polarity)}. Evidence confidence: Not assessed.</p>{[{name:'Supporting',ids:relationship.supportingClaimIds},{name:'Qualifying',ids:relationship.qualifyingClaimIds},{name:'Contradicting',ids:relationship.contradictingClaimIds}].map(category => <div><p>{category.name} claims</p><ul>{category.ids.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul>{category.ids.length === 0 && <p class="empty-note">None recorded; this does not establish absence of evidence.</p>}</div>)}</article>)}</div></details>
    <details open><summary>Claims and linked evidence ({release.claims.length})</summary><div class="outline-content">{release.claims.map(claim => <article id={`claim-${claim.id}`}><span class="record-label">{readable(claim.verification)} · {readable(claim.reviewDisposition?.decision ?? 'unverified')}</span><h3>{claim.text}</h3><p>Context: {release.contexts.find(context => context.id === claim.contextId)?.label}. Interpretation: {readable(claim.causalInterpretation)}. Source checked: {claim.sourceCheckedAt}.</p><p>Limitations: {claim.limitations.join(' ')}</p><ul>{claim.evidenceItemIds.map(id => { const evidence = release.evidenceItems.find(item => item.id === id); const source = release.sources.find(item => item.id === evidence?.sourceId); return <li>{evidence?.summary}<p>Study system: {evidence?.studySystem} · {readable(evidence?.evidenceType ?? '')}</p><p>Location: {evidence?.location}. Retrieved: {evidence?.retrievedAt}. Study: {source?.studyId}. Read: {source?.accessScope}.</p>{source && <a href={source.url}>{source.title}</a>}</li>; })}</ul></article>)}</div></details>
    <details open id="therapies"><summary>Therapeutic interventions ({release.therapies.length})</summary><div class="outline-content">{release.therapies.map(therapy => <article id={`therapy-${therapy.id}`}><span class="record-label">{readable(therapy.developmentStatus)} · Editorial candidate</span><h3>{therapy.name}</h3><p>{therapy.mechanismOfAction}</p><p>Direct targets: {therapy.directTargetIds.map(entityLabel).join(', ')}. Indirect effects: {therapy.indirectTargetIds.map(entityLabel).join(', ')}.</p><p>Indication: {therapy.indication}</p><p>{therapy.jurisdiction} · {therapy.trialPhase} · Last verified {therapy.lastVerifiedAt}</p><ul>{therapy.limitations?.map(limit => <li>{limit}</li>)}</ul>{[{name:'Supporting',ids:therapy.supportingClaimIds},{name:'Qualifying',ids:therapy.qualifyingClaimIds ?? []},{name:'Contradicting',ids:therapy.contradictingClaimIds ?? []}].map(category => <div><p>{category.name} evidence</p><ul>{category.ids.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul>{category.ids.length === 0 && <p class="empty-note">None recorded; this does not establish absence of evidence.</p>}</div>)}<p>Status verification: {therapy.verificationSourceIds?.map(id => { const source = release.sources.find(item => item.id === id); return source && <a href={source.url}>{source.title} </a>; })}</p></article>)}</div></details>
    <details open><summary>Initial candidate note & identity</summary><div class="outline-content"><p>{release.releaseNote}</p><p>Root candidate: {release.id}. Revision: {release.revisionId}. Parent: none.</p><p class="release-digest">SHA-256: <code>{release.manifest.contentDigest}</code></p><p><a href="/methodology/">Read the methodology and publication policy</a> · <a href="/sources/">Inspect every source</a></p></div></details>
  </section>
</AtlasLayout>
