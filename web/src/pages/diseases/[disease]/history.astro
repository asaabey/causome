---
import { atlas } from '../../../data/atlas';
import { sitePath } from '../../../data/site';
import AtlasLayout from '../../../layouts/AtlasLayout.astro';
export function getStaticPaths() { return atlas.map(item => ({ params: { disease: item.profile.id }, props: { item } })); }
const { item } = Astro.props;
---
<AtlasLayout title={`${item.profile.label}: release history`}>
  <section class="page-width content-page"><p class="eyebrow">Versioned evidence</p><h1>Release history</h1><p>{item.profile.label}. Each version embeds its claims, contexts, sources, assessments and layout.</p>
    <ul class="version-list">{item.versions.map(version => <li><span class="pill">{['approved','published'].includes(version.status) ? 'Reviewed release' : 'Candidate'}</span><h2><a href={sitePath(`/diseases/${item.profile.id}/${['approved','published'].includes(version.status) ? 'releases' : 'candidates'}/${version.id}/`)}>{version.id}</a></h2><details><summary>Snapshot notes</summary><p>{version.releaseNote}</p></details><p>Evidence cutoff {version.evidenceCutoff} · Parent {version.parentReleaseId ?? 'none'}</p><p class="release-digest">SHA-256: <code>{version.manifest.contentDigest}</code></p></li>)}</ul>
    <a class="button-link" href={sitePath(`/diseases/${item.profile.id}/compare/`)}>Compare versions</a>
  </section>
</AtlasLayout>
