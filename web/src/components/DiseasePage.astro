---
import { sitePath } from '../data/site';
import AtlasLayout from '../layouts/AtlasLayout.astro';
import MechanismMap from './MechanismMap';
import AssessmentCard from './AssessmentCard.astro';
import SummaryParagraph from './SummaryParagraph';
import type { ReleaseBundle } from '../data/types';
import { shortLabelsFor, type DiseaseProfile } from '../data/atlas';
interface Props { release: ReleaseBundle; disease: DiseaseProfile; isPublication: boolean; historical?: boolean }
const { release, disease: profile, isPublication, historical = false } = Astro.props;
const disease = isPublication || historical ? { ...profile, label: release.title, summary: release.diseaseDescription ?? (isPublication ? release.releaseNote : 'Explore this snapshot’s mechanisms, claims and source evidence.') ?? 'Reviewed contextual evidence and limitations.', aliases: release.diseaseAliases ?? [] } : profile;
const entityLabel = (id: string) => release.entities.find(entity => entity.id === id)?.label ?? id;
const claimFor = (id: string) => release.claims.find(claim => claim.id === id);
const readable = (value: string) => value.replaceAll('_', ' ');
const normalise = (text = '') => text.trim().replace(/\s+/g, ' ').replace(/\.$/, '').toLowerCase();
// Many profiles reuse the summary scope as their description, so show it only where it adds something.
const summaryScope = release.scientificSummary && normalise(release.scientificSummary.scope) !== normalise(disease.summary) ? release.scientificSummary.scope : undefined;
---
<AtlasLayout title={disease.label} description={disease.summary}>
  <section class="disease-hero page-width">
    <div class="breadcrumbs"><a href={sitePath("/")}>Atlas</a><span aria-hidden="true">/</span><span>{disease.label}</span></div>
    <div class="disease-heading">
      <div><p class="eyebrow">Disease map · {disease.aliases[0] ?? disease.id}</p><h1>{disease.label}</h1><p class="hero-description">{disease.summary}</p></div>
      <dl class="release-meta"><dt>{isPublication ? release.parentReleaseId ? 'Reviewed successor release' : 'Reviewed root release' : 'Scientific candidate'}</dt><dd>{release.id}</dd><dt>Evidence cutoff</dt><dd>{release.evidenceCutoff}</dd></dl>
    </div>
    {isPublication && <aside class="preview-notice" aria-label="Scientific review status"><span class="notice-symbol" aria-hidden="true">i</span><div><strong>Reviewed scientific release</strong>Each claim identifies its study system, context and limitations. The release records approval of this exact scientific and view content.</div></aside>}
  </section>
  <nav class="page-width release-tools" aria-label="Release tools"><a href={sitePath(`/diseases/${disease.id}/history/`)}>Release history</a><a href={sitePath(`/diseases/${disease.id}/compare/`)}>Compare versions</a>{historical && <a href={sitePath(`/diseases/${disease.id}/`)}>Return to current map</a>}</nav>
  {release.scientificSummary && <section class="page-width scientific-summary" aria-labelledby="summary-heading"><h2 id="summary-heading">Overall scientific summary</h2>{summaryScope && <p class="summary-scope"><strong>Scope</strong> {summaryScope}</p>}{release.scientificSummary.paragraphs.map(paragraph => <SummaryParagraph text={paragraph.text} entities={release.entities} />)}{!historical && <p class="summary-tools"><a href={sitePath(`/diseases/${disease.id}/summary-review.md`)} download>Download summary and external review prompt</a><a href={sitePath(`/curation/?disease=${disease.id}`)}>Review this summary in the curator</a></p>}</section>}
  <section class="map-section" aria-labelledby="map-heading">
    <div class="map-section-heading"><div><h2 id="map-heading">Mechanism map</h2><p>{release.entities.length} entities · {release.relationships.length} relationships · {release.therapies.length} therapies</p></div><a href="#mechanism-outline">Read the text outline ↓</a></div>
    <MechanismMap release={release} shortLabels={shortLabelsFor(profile.id)} client:load />
    <noscript><p class="preview-notice">The interactive map needs JavaScript. Every entity, relationship, therapy and evidence item is available in the text outline below.</p></noscript>
  </section>
  <section id="mechanism-outline" class="outline-section page-width" aria-labelledby="outline-heading">
    <h2 id="outline-heading">Text outline</h2>
    <details open><summary>Entities ({release.entities.length})</summary><div class="outline-content">{release.entities.map(entity => <article id={`entity-${entity.id}`}><span class="record-label">{readable(entity.entityClass)} · {readable(entity.status)}</span><h3>{entity.label}</h3><p>{entity.description}</p><div>{release.assessments.filter(item=>item.subjectId===entity.id).map(assessment=><AssessmentCard assessment={assessment} release={release} />)}</div><ul>{entity.biologicalRoleClaimIds.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul></article>)}</div></details>
    <details open><summary>Relationships ({release.relationships.length})</summary><div class="outline-content">{release.relationships.map(relationship => <article id={`relationship-${relationship.id}`}><span class="record-label">{relationship.directionality === 'symmetric' ? 'Symmetric association' : 'Directed relationship'} · {readable(relationship.status)}</span><h3>{entityLabel(relationship.sourceId)} {readable(relationship.predicate)} {entityLabel(relationship.targetId)}</h3><p>Context: {release.contexts.find(context => context.id === relationship.contextId)?.label}. Polarity: {readable(relationship.polarity)}. Evidence confidence: {release.assessments.find(item => item.id === relationship.assessmentId)?.evidenceConfidence ?? 'Not assessed'}.</p>{release.assessments.filter(item=>item.id===relationship.assessmentId).map(assessment=><AssessmentCard assessment={assessment} release={release} />)}{[{name:'Supporting',ids:relationship.supportingClaimIds},{name:'Qualifying',ids:relationship.qualifyingClaimIds},{name:'Contradicting',ids:relationship.contradictingClaimIds}].map(category => <div><p>{category.name} claims</p><ul>{category.ids.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul>{category.ids.length === 0 && <p class="empty-note">None recorded; this does not establish absence of evidence.</p>}</div>)}</article>)}</div></details>
    <details open><summary>Claims and linked evidence ({release.claims.length})</summary><div class="outline-content">{release.claims.map(claim => <article id={`claim-${claim.id}`}><span class="record-label">{readable(claim.verification)}{claim.reviewDisposition && claim.reviewDisposition.decision !== 'pending_domain_review' && ` · ${readable(claim.reviewDisposition.decision)}`}</span><h3>{claim.text}</h3><p>Context: {release.contexts.find(context => context.id === claim.contextId)?.label}. Interpretation: {readable(claim.causalInterpretation)}. Source checked: {claim.sourceCheckedAt}.</p><p>Limitations: {claim.limitations.join(' ')}</p><ul>{claim.evidenceItemIds.map(id => { const evidence = release.evidenceItems.find(item => item.id === id); const source = release.sources.find(item => item.id === evidence?.sourceId); return <li>{evidence?.summary}<p>Study system: {evidence?.studySystem} · {readable(evidence?.evidenceType ?? '')}</p><p>Location: {evidence?.location}. Retrieved: {evidence?.retrievedAt}. Study: {source?.studyId}. Read: {source?.accessScope}.</p>{source && <a href={source.url}>{source.title}</a>}</li>; })}</ul></article>)}</div></details>
    <details open id="therapies"><summary>Therapeutic interventions ({release.therapies.length})</summary><div class="outline-content">{release.therapies.map(therapy => <article id={`therapy-${therapy.id}`}><span class="record-label">{readable(therapy.developmentStatus)} · Editorial {readable(therapy.status)}</span><h3>{therapy.name}</h3><p>{therapy.mechanismOfAction}</p><p>Direct targets: {therapy.directTargetIds.map(entityLabel).join(', ')}. Indirect effects: {therapy.indirectTargetIds.map(entityLabel).join(', ')}.</p><p>Indication: {therapy.indication}</p><p>{therapy.jurisdiction} · {therapy.trialPhase} · Last verified {therapy.lastVerifiedAt}</p><ul>{therapy.limitations?.map(limit => <li>{limit}</li>)}</ul>{[{name:'Supporting',ids:therapy.supportingClaimIds},{name:'Qualifying',ids:therapy.qualifyingClaimIds ?? []},{name:'Contradicting',ids:therapy.contradictingClaimIds ?? []}].map(category => <div><p>{category.name} evidence</p><ul>{category.ids.map(id => <li><a href={`#claim-${id}`}>{claimFor(id)?.text ?? id}</a></li>)}</ul>{category.ids.length === 0 && <p class="empty-note">None recorded; this does not establish absence of evidence.</p>}</div>)}<p>Status verification: {therapy.verificationSourceIds?.map(id => { const source = release.sources.find(item => item.id === id); return source && <a href={source.url}>{source.title} </a>; })}</p></article>)}</div></details>
    <details><summary>{isPublication ? 'Initial release note & identity' : 'Initial candidate note & identity'}</summary><div class="outline-content"><p>{release.releaseNote}</p><p>{isPublication ? 'Release' : 'Candidate'}: {release.id}. Revision: {release.revisionId}. Parent: {release.parentReleaseId ?? 'none'}.</p><p class="release-digest">SHA-256: <code>{release.manifest.contentDigest}</code></p><p><a href={sitePath("/methodology/")}>Read the methodology and publication policy</a> · <a href={sitePath("/sources/")}>Inspect every source</a></p></div></details>
  </section>
  <script is:inline>
    // Sections stay open without JavaScript; with it, the inspector covers browsing, so collapse them and reopen whichever one a link targets.
    (() => {
      const outline = document.getElementById('mechanism-outline');
      if (!outline) return;
      const reveal = hash => { const target = hash.length > 1 && document.getElementById(decodeURIComponent(hash.slice(1))); for (let section = target && outline.contains(target) ? target.closest('details') : null; section; section = section.parentElement.closest('details')) section.open = true; };
      outline.querySelectorAll(':scope > details[open]').forEach(section => section.removeAttribute('open'));
      reveal(location.hash);
      document.addEventListener('click', event => { const link = event.target instanceof Element && event.target.closest('a[href*="#"]'); if (link && link.pathname === location.pathname) reveal(link.hash); }, true);
      addEventListener('hashchange', () => reveal(location.hash));
    })();
  </script>
</AtlasLayout>
